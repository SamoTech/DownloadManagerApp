<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activity.BrowserActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Smart Browser Header & Address Bar -->
        <LinearLayout
            android:id="@+id/browserHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorHeaderBg"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvBrowserHeaderVersion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Luca Browser • Ready"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderSniffCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:backgroundTint="#1E293B"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="0 Media"
                    android:textColor="#10B981"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Smart Omnibox Row: Exit | [Lock + URL/Search] | Copy | Share | Refresh/Stop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnCloseBrowser"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/exit"
                    android:src="@drawable/ic_back"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_background"
                    android:backgroundTint="@color/colorDashboardCard"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/ivSecurityLock"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="HTTPS Security Status"
                        android:src="@drawable/ic_lock"
                        app:tint="#10B981" />

                    <EditText
                        android:id="@+id/etBrowserUrl"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/browser_url_hint"
                        android:imeOptions="actionGo"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:selectAllOnFocus="true"
                        android:singleLine="true"
                        android:textColor="@android:color/white"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnBrowserGo"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/search_hint"
                        android:src="@drawable/ic_search"
                        app:tint="#38BDF8" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCopyUrl"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/copy_link"
                    android:src="@drawable/ic_copy"
                    app:tint="#CBD5E1" />

                <ImageButton
                    android:id="@+id/btnShareUrl"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/share"
                    android:src="@drawable/ic_share"
                    app:tint="#CBD5E1" />

                <ImageButton
                    android:id="@+id/btnBrowserReload"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/retry"
                    android:src="@drawable/ic_retry"
                    app:tint="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBarWeb"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar_drawable"
            android:visibility="gone" />

        <!-- Browser Viewport Container: Speed Dial Home Hub + Full Live WebView + Renderer Recovery -->
        <FrameLayout
            android:id="@+id/browserContentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#0F172A">

            <!-- Live WebView Container (Always active for web browsing, media playback & sniffing) -->
            <FrameLayout
                android:id="@+id/webViewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/white" />

            <!-- Home Hub & Platform Speed Dial (Shown only on Browser Home) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/homeSpeedDialContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0F172A"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#1E293B"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/icon_badge_background"
                                    android:backgroundTint="#0284C7">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@string/smart_browser"
                                        android:src="@drawable/ic_browser"
                                        app:tint="@android:color/white" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Luca Media Browser"
                                        android:textColor="@android:color/white"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Browse public websites &amp; download open-access media and files"
                                        android:textColor="#94A3B8"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <EditText
                                    android:id="@+id/etHomeSearch"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/card_background"
                                    android:backgroundTint="#0F172A"
                                    android:hint="@string/browser_url_hint"
                                    android:imeOptions="actionSearch"
                                    android:importantForAutofill="no"
                                    android:inputType="text"
                                    android:paddingHorizontal="14dp"
                                    android:singleLine="true"
                                    android:textColor="@android:color/white"
                                    android:textColorHint="#94A3B8"
                                    android:textSize="14sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnHomeSearch"
                                    style="@style/Widget.Material3.Button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:layout_marginStart="8dp"
                                    android:text="Go"
                                    android:textSize="13sp"
                                    app:backgroundTint="@color/colorPrimary"
                                    app:cornerRadius="12dp"
                                    app:icon="@drawable/ic_search"
                                    app:iconSize="16dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/browser_speed_dial_title"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Supported Platform Quick Bookmarks Grid -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSpeedDial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Renderer Crash / Offline Recovery Overlay -->
            <LinearLayout
                android:id="@+id/browserRecoveryOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0F172A"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvOverlayBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_background"
                    android:backgroundTint="#1E293B"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Luca Browser"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOverlayTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:text="Web Page Interrupted"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOverlaySubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxWidth="360dp"
                    android:text="Tap Retry to reload this page and resume stream detection."
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlayRetry"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/retry"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_retry" />
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom Browser Navigation, Multi-Tab Switcher & Engine Toggles -->
        <LinearLayout
            android:id="@+id/browserBottomBar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@color/colorHeaderBg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btnNavBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btnNavForward"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Forward"
                android:src="@drawable/ic_forward"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btnNavHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Speed Dial Home"
                android:src="@drawable/ic_browser"
                app:tint="#38BDF8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabs"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="48dp"
                android:paddingHorizontal="10dp"
                android:text="1"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="#475569"
                app:strokeWidth="1.5dp" />

            <TextView
                android:id="@+id/tvSnifferStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Sniffer Active"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleDesktop"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/browser_desktop_mode"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleAdBlock"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/browser_adblock_short"
                android:textColor="#38BDF8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Animated Floating Media Detection Badge ("Download Media (N)") -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabDetectedLinks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:contentDescription="@string/detected_links"
        android:text="Download Media (0)"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@color/colorPrimary"
        app:icon="@drawable/ic_download"
        app:iconTint="@android:color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
